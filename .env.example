# --- Discord ---
DISCORD_TOKEN=

# --- PUBG (developer.pubg.com) ---
PUBG_API_KEY=
PUBG_SHARD=steam

# --- Roster del squad ---
# Opcional: solo hace falta si NO tenés squad.json (ej: al hostear en Railway/Render,
# donde ese archivo no existe porque está en .gitignore). Nombres separados por coma.
# SQUAD_ROSTER=NombreExactoEnPUBG1,NombreExactoEnPUBG2

# --- Aviso de mantenimiento de PUBG (vía noticias de Steam) ---
# Canal de Discord donde se postea cuando aparece un aviso nuevo de mantenimiento.
# Sin esta variable, el chequeo automático queda desactivado (podés seguir usando
# /mantenimiento a mano igual).
NOTIFY_CHANNEL_ID=

# Cada cuántos segundos chequear (por defecto 1800 = 30 minutos)
MAINTENANCE_CHECK_SECONDS=1800

# --- Anuncio automático semanal del jugador de la semana ---
# Canal donde se postea (si no se define, usa NOTIFY_CHANNEL_ID).
# WEEKLY_ANNOUNCE_CHANNEL_ID=

# Día y hora (en UTC) del anuncio. Por defecto: domingo 23:00 UTC = domingo 20:00 en Argentina.
# weekday: lunes=0, martes=1, miércoles=2, jueves=3, viernes=4, sábado=5, domingo=6
WEEKLY_ANNOUNCE_WEEKDAY=6
WEEKLY_ANNOUNCE_HOUR_UTC=23
